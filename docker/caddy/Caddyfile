# The deployed frontend: the built app for the main host and every Organisation subdomain alike, and the
# same-origin /api proxy to the API. Traefik terminates TLS in front of it, so Caddy speaks plain HTTP.
{
	auto_https off
	admin off
	servers {
		# Traefik reaches this server over Dokploy's shared Docker network. Trusting it keeps the
		# X-Forwarded-For it set (the browser's address) and appends Traefik's own, so the API, behind two
		# proxies, finds the browser's address second from the end (TRUST_PROXY_HOPS=2). It also keeps
		# Traefik's X-Forwarded-Host and X-Forwarded-Proto. Every other container on that network is a
		# private peer too, so /api serves only requests carrying the edge secret, which only Traefik adds.
		trusted_proxies static private_ranges
	}
}

:80 {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		# Traefik sets the edge secret on every request it routes here, replacing whatever the client sent. A
		# request without it bypassed Traefik, from another container on the shared network, with an
		# X-Forwarded-For of its choosing.
		@notFromEdge not header X-Edge-Secret {$EDGE_SECRET}
		respond @notFromEdge 403

		# The API under its deployment's own name: this container also sits on Dokploy's shared network,
		# where another project's service could be called plain `api`.
		reverse_proxy {$API_UPSTREAM} {
			# Replaces whatever the client sent under this name; the API refuses any request without it.
			header_up X-Proxy-Secret {env.PROXY_SECRET}
			header_up -X-Edge-Secret
		}
	}

	# Built files carry a content hash in their name, so they never change; a missing one is a 404, never
	# the app's page cached for good.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# Every other path is the app's: the router decides by host and path. Asked for again on every load,
	# so a deployment reaches the browser at once.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		# Only this origin's scripts run, and the one inline script of index.html (the theme, before the
		# first paint) by its hash: a changed script needs a new hash here, or the theme flashes. Styles
		# may be inline, since UI libraries and the email preview set them and a style runs no code.
		# QR codes are drawn as data: images.
		header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-6vfj6Dt2LiNLWmNpMpDs6egLUZYojneLO0Eo9u7n4/A='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
