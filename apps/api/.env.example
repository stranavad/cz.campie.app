# Local development against the Docker Compose services (root `pnpm docker:up`). Copy to `.env`.
APP_ENV=local
# Browsers resolve app.localhost and every <subdomain>.localhost to this machine.
PLATFORM_DOMAIN=localhost
# Emailed links use it; production requires https.
PLATFORM_SCHEME=http
PRODUCT_NAME=Campie
# New signups and problem reports are announced here; locally the mail only reaches the log.
PLATFORM_OPERATOR_EMAIL=operator@example.com
# Shown to guardians as the contact for technical problems.
PLATFORM_SUPPORT_EMAIL=info@campie.cz
# Proxies in front of the API that append to X-Forwarded-For: the dev server's proxy.
TRUST_PROXY_HOPS=1
# Deployments require it (and the frontend's proxy sends it); unset, the API takes requests without it.
# PROXY_SECRET=

# The API connects as the application role, which row-level security applies to; migrations
# (`pnpm db:migrate`) run as the role that owns the tables.
DATABASE_URL=postgres://campie_app:campie_app@localhost:15432/campie
MIGRATION_DATABASE_URL=postgres://campie:campie@localhost:15432/campie
REDIS_URL=redis://localhost:16379
# auto runs queued jobs in this process; production requires it.
JOB_WORKER=auto

# One variable per port picks its adapter. Production requires the first of each pair:
# neon|pg, system|controllable, resend|log, tigris|s3, gotenberg|fake, comgate|fake, secret|fixed.
DATABASE_ADAPTER=pg
CLOCK_ADAPTER=system
MAIL_ADAPTER=log
FILE_STORAGE_ADAPTER=s3
PDF_RENDERER_ADAPTER=gotenberg
PAYMENT_GATEWAY_ADAPTER=fake
# With PAYMENT_GATEWAY_ADAPTER=comgate: true sends Comgate test payments (staging).
# COMGATE_TEST_PAYMENTS=false
KEY_PROVIDER_ADAPTER=fixed

S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=campie
S3_ACCESS_KEY_ID=campie-local
S3_SECRET_ACCESS_KEY=campie-local-secret

GOTENBERG_URL=http://localhost:13000

# The two sending streams, each on its own subdomain of the platform's mail domain: login links, email
# verification and invitations, and everything else.
MAIL_AUTH_FROM=prihlaseni@auth.localhost
MAIL_NOTIFICATION_FROM=info@posta.localhost

# Failed admin logins allowed per email and per IP address within the lockout period, which then blocks them.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15

# Anonymous requests that send mail or create data, allowed per IP address and per email within the window.
REQUEST_LIMIT_WINDOW_MINUTES=60
SIGNUP_LIMIT_PER_IP=10
SIGNUP_LIMIT_PER_EMAIL=5
PASSWORD_RESET_LIMIT_PER_IP=20
PASSWORD_RESET_LIMIT_PER_EMAIL=3
# The form's live price asks as it is filled in: per IP address and per Organisation.
PRICE_PREVIEW_LIMIT_PER_IP=600
PRICE_PREVIEW_LIMIT_PER_ORGANISATION=20000
# Submitted registration forms: per IP address (mobile networks share one among many families) and per
# Organisation, well above a popular Camp's opening rush.
SUBMISSION_LIMIT_PER_IP=50
SUBMISSION_LIMIT_PER_ORGANISATION=5000
# Guardians' portal login links: per IP address and per email.
LOGIN_LINK_LIMIT_PER_IP=30
LOGIN_LINK_LIMIT_PER_EMAIL=5
GATEWAY_NOTIFICATION_LIMIT_PER_IP=20000
GATEWAY_NOTIFICATION_LIMIT_PER_ORGANISATION=2000
CARD_PAYMENT_LIMIT_PER_IP=100
CARD_PAYMENT_LIMIT_PER_ORGANISATION=5000
PAYMENT_REMINDER_LIMIT_PER_ORGANISATION=10
GUARDIAN_ACTION_LIMIT_PER_IP=300
GUARDIAN_ACTION_LIMIT_PER_EMAIL=100
PROBLEM_REPORT_LIMIT_PER_IP=20
PROBLEM_REPORT_LIMIT_PER_TARGET=50

# Production adapters, set in the deployment:
# RESEND_API_KEY=
# The signing secret of the Resend webhook for bounces and complaints (whsec_...).
# RESEND_WEBHOOK_SECRET=
# TIGRIS_STORAGE_ENDPOINT= TIGRIS_STORAGE_BUCKET= TIGRIS_STORAGE_ACCESS_KEY_ID= TIGRIS_STORAGE_SECRET_ACCESS_KEY=
# MASTER_KEY=   (32 random bytes in base64: `openssl rand -base64 32`)
