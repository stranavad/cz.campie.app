# Local development against the Docker Compose services (root `pnpm docker:up`). Copy to `.env`.
APP_ENV=local

DATABASE_URL=postgres://campie:campie@localhost:15432/campie
REDIS_URL=redis://localhost:16379

S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=campie
S3_ACCESS_KEY_ID=campie-local
S3_SECRET_ACCESS_KEY=campie-local-secret

GOTENBERG_URL=http://localhost:13000
