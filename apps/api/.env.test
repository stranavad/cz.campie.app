# Committed and secret-free. Tests get their services' addresses from the harness; until then nothing
# listens on port 1, so a test can never reach the local stack.
APP_ENV=test
PLATFORM_DOMAIN=campie.test

DATABASE_URL=postgres://campie_app:campie_app@127.0.0.1:1/campie
REDIS_URL=redis://127.0.0.1:1
# Jobs stay queued until a test drains them, one at a time.
JOB_WORKER=manual

DATABASE_ADAPTER=pg
CLOCK_ADAPTER=controllable
MAIL_ADAPTER=fake
FILE_STORAGE_ADAPTER=memory
PDF_RENDERER_ADAPTER=fake
PAYMENT_GATEWAY_ADAPTER=fake
KEY_PROVIDER_ADAPTER=fixed

MAIL_AUTH_FROM=prihlaseni@auth.campie.test
MAIL_NOTIFICATION_FROM=info@posta.campie.test
