# Committed and secret-free. Tests get their services' addresses from the harness; until then nothing
# listens on port 1, so a test can never reach the local stack.
APP_ENV=test
PLATFORM_DOMAIN=campie.test
PLATFORM_SCHEME=https
PRODUCT_NAME=Campie
PLATFORM_OPERATOR_EMAIL=operator@example.com

DATABASE_URL=postgres://campie_app:campie_app@127.0.0.1:1/campie
REDIS_URL=redis://127.0.0.1:1
# Jobs stay queued until a test drains them, one at a time.
JOB_WORKER=manual

DATABASE_ADAPTER=pg
CLOCK_ADAPTER=controllable
MAIL_ADAPTER=fake
FILE_STORAGE_ADAPTER=memory
PDF_RENDERER_ADAPTER=fake
PAYMENT_GATEWAY_ADAPTER=fake
KEY_PROVIDER_ADAPTER=fixed

MAIL_AUTH_FROM=prihlaseni@auth.campie.test
MAIL_NOTIFICATION_FROM=info@posta.campie.test

LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15

# Relaxed, since every test calls from one address; a test of the limits sets its own.
REQUEST_LIMIT_WINDOW_MINUTES=60
SIGNUP_LIMIT_PER_IP=1000
SIGNUP_LIMIT_PER_EMAIL=1000
PASSWORD_RESET_LIMIT_PER_IP=1000
PASSWORD_RESET_LIMIT_PER_EMAIL=1000
PRICE_PREVIEW_LIMIT_PER_IP=1000
PRICE_PREVIEW_LIMIT_PER_ORGANISATION=1000
SUBMISSION_LIMIT_PER_IP=1000
SUBMISSION_LIMIT_PER_ORGANISATION=1000
LOGIN_LINK_LIMIT_PER_IP=1000
LOGIN_LINK_LIMIT_PER_EMAIL=1000
GATEWAY_NOTIFICATION_LIMIT_PER_IP=1000
GATEWAY_NOTIFICATION_LIMIT_PER_ORGANISATION=1000
CARD_PAYMENT_LIMIT_PER_IP=1000
CARD_PAYMENT_LIMIT_PER_ORGANISATION=1000
PAYMENT_REMINDER_LIMIT_PER_ORGANISATION=1000
GUARDIAN_ACTION_LIMIT_PER_IP=1000
GUARDIAN_ACTION_LIMIT_PER_EMAIL=1000
