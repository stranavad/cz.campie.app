---
import Icon from '../../components/Icon.astro';
import BasisBadge from '../../components/kit/BasisBadge.astro';
import CiteLinks from '../../components/kit/CiteLinks.astro';
import Claims from '../../components/kit/Claims.astro';
import Configurator from '../../components/kit/Configurator.astro';
import Legend from '../../components/kit/Legend.astro';
import Tag from '../../components/kit/Tag.astro';
import Verification from '../../components/kit/Verification.astro';
import type { DocumentSlug } from '../../content/kit/types.ts';
import { documentKey } from '../../content/seo.ts';
import Base from '../../layouts/Base.astro';
import { documentPage, documentPreview, documentStaticPaths } from '../../lib/kit/pages.ts';

export const getStaticPaths = documentStaticPaths;

interface Props {
  slug: DocumentSlug;
}

const { slug } = Astro.props;
const page = documentPage(slug);
const preview = await documentPreview(slug);
---

<Base page={documentKey(slug)} wide>
  <style slot="head" is:inline set:html={preview.css} />

  <div class="wrap text-ink">
    <header class="flex flex-col pt-2 pb-7">
      <Verification verification={page.verification} />
      <h1 class="h-card mt-3.5 mb-3 max-w-[20ch] text-[52px] leading-[1.05] tracking-[-0.03em] text-balance phone:text-[32px]">
        {page.title}
      </h1>
      <p class="m-0 max-w-[60ch] text-[19px] text-muted phone:text-[17px]">{page.lead}</p>

      <div class="mt-5 flex max-w-[860px] items-start gap-4 rounded-2xl border border-line bg-card px-5 py-4 phone:p-3.5">
        <span
          aria-hidden="true"
          class="flex size-9 flex-none items-center justify-center rounded-full bg-forest text-cream"
        >
          <Icon name="clock" size={18} stroke={2.4} />
        </span>
        <div class="flex min-w-0 flex-col gap-1">
          <p
            class="m-0 text-[18px] leading-[1.45] phone:text-[16.5px] [&_a]:underline [&_a]:underline-offset-4"
            set:html={page.answer.html}
          />
          <p class="m-0 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[12.5px] leading-[1.45] text-muted">
            <BasisBadge basis={page.answer.basis} label={page.answer.basisLabel} mark={page.answer.mark} />
            {page.answer.cites.map((cite) => (
              <span>
                ·{' '}
                <a
                  href={cite.href}
                  rel="noopener"
                  class="text-muted underline decoration-line2 underline-offset-[3px] hover:text-ink"
                >
                  {cite.label}
                </a>
              </span>
            ))}
          </p>
        </div>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <div class="card flex flex-col items-start gap-2.5 rounded-[22px] px-6 py-[22px] phone:p-[18px]">
          <span class="font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
            {page.paths.blank.eyebrow}
          </span>
          <h2 class="h-card text-[24px] leading-[1.1] tracking-[-0.03em] text-balance">{page.paths.blank.title}</h2>
          <p class="m-0 text-[16px] text-muted">{page.paths.blank.text}</p>
          <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1.5 phone:w-full">
            <a
              href={page.blank.href}
              download={page.blank.download}
              class="btn gap-2.5 hover:brightness-105 phone:w-full phone:justify-center"
              {...page.blank.event}
            >
              <Icon name="download" size={18} stroke={2.4} />
              {page.blank.label}
            </a>
            <span class="font-mono text-[12.5px] text-muted">{preview.pdfMeta}</span>
          </div>
        </div>
        {page.paths.custom && page.customise && (
          <div
            hidden
            data-configurator-link
            class="card flex flex-col items-start gap-2.5 rounded-[22px] px-6 py-[22px] phone:p-[18px]"
          >
            <span class="font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
              {page.paths.custom.eyebrow}
            </span>
            <h2 class="h-card text-[24px] leading-[1.1] tracking-[-0.03em] text-balance">{page.paths.custom.title}</h2>
            <p class="m-0 text-[16px] text-muted">{page.paths.custom.text}</p>
            <a
              href={page.customise.href}
              class="mt-1 inline-flex h-[52px] items-center justify-center gap-2.5 rounded-full border-[1.5px] border-ink px-6 font-bold whitespace-nowrap text-ink no-underline hover:bg-chip phone:w-full"
            >
              {page.customise.label}
              <Icon name="down" size={18} stroke={2.4} />
            </a>
          </div>
        )}
        {page.formWhy && (
          <div class="card flex flex-col items-start gap-2.5 rounded-[22px] px-6 py-[22px] phone:p-[18px]">
            <span class="font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
              {page.formWhy.eyebrow}
            </span>
            <h2 class="h-card flex items-center gap-2.5 text-[24px] leading-[1.1] tracking-[-0.03em] text-balance">
              <Icon name="lock" size={20} class="flex-none" />
              {page.formWhy.title}
            </h2>
            <p class="m-0 text-[16px] text-muted">{page.formWhy.text}</p>
          </div>
        )}
      </div>
    </header>

    <section
      id={page.configuratorId}
      data-cfg
      aria-label={page.customise ? page.configurator.title : page.previewTitle}
      class="group/cfg mt-10 border-t border-line pt-14 pb-16 phone:mt-7 phone:pt-10 phone:pb-12"
    >
      {page.customise && (
        <div hidden data-configurator-link class="mb-[22px] flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <div class="flex flex-col gap-2">
            <span class="font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
              {page.configurator.eyebrow}
            </span>
            <h2 class="h-card text-[36px] leading-[1.05] tracking-[-0.03em] phone:text-[28px]">
              {page.configurator.title}
            </h2>
          </div>
          <p class="m-0 inline-flex max-w-[420px] items-center gap-2.5 rounded-[14px] bg-chip px-3.5 py-2.5 text-[14.5px] leading-[1.35] font-semibold">
            <Icon name="lock" size={22} class="flex-none" />
            <span>{page.configurator.privacy}</span>
          </p>
        </div>
      )}
      {page.customise && <div data-cfg-tabs class="sticky top-0 z-10 -mx-5 mb-4 empty:hidden xl:hidden"></div>}

      <div class="grid items-start gap-8 max-xl:gap-4 xl:group-has-[[data-configurator]:not([hidden])]/cfg:grid-cols-[minmax(0,1fr)_680px]">
        {page.customise && (
          <Configurator slug={slug} blank={{ href: page.blank.href, download: page.blank.download }} />
        )}
        <div class="mx-auto flex w-full max-w-[860px] min-w-0 flex-col gap-3 max-xl:group-data-[tab=form]/cfg:hidden xl:group-has-[[data-configurator]:not([hidden])]/cfg:sticky xl:group-has-[[data-configurator]:not([hidden])]/cfg:top-4 xl:group-has-[[data-configurator]:not([hidden])]/cfg:max-h-[calc(100dvh-32px)] xl:group-has-[[data-configurator]:not([hidden])]/cfg:max-w-none xl:group-has-[[data-configurator]:not([hidden])]/cfg:overflow-y-auto">
          <div data-preview-bar class="flex flex-col gap-2.5">
            <div class="flex items-center justify-between gap-2.5">
              <span class="font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
                {page.previewLabel}
              </span>
              <span class="font-mono text-[12.5px] text-muted">{preview.pages}</span>
            </div>
          </div>
          <div class="rounded-[22px] bg-chip p-[18px] max-xl:-mx-2 max-xl:p-3">
            <div data-print-sheet data-preview class="kp-stack w-full" set:html={preview.html} />
          </div>
        </div>
      </div>
    </section>
  </div>

  <section aria-labelledby="zakon" class="border-t border-line bg-card py-[72px] text-ink phone:py-12">
    <div class="wrap grid items-start gap-12 phone:gap-7 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="flex min-w-0 flex-col gap-12">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-2.5">
            <span class="font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
              {page.explain.eyebrow}
            </span>
            <h2 id="zakon" class="h-card text-[40px] leading-[1.05] tracking-[-0.03em] text-balance phone:text-[30px]">
              {page.explain.title}
            </h2>
          </div>
          <Legend />
          {page.explain.sections.map((section) => (
            <section aria-labelledby={section.id} class="flex flex-col gap-3">
              <div class="flex flex-col gap-0.5">
                <h3 id={section.id} class="m-0 text-[21px] leading-snug font-bold">
                  {section.title}
                </h3>
                <a
                  href={section.origin.href}
                  class="inline-flex min-h-8 items-center gap-1.5 self-start text-[15px] font-semibold text-muted underline underline-offset-4 hover:text-ink"
                >
                  {section.origin.label}
                  <Icon name="arrow" size={14} />
                </a>
              </div>
              {section.intro && <p class="m-0 max-w-[70ch] text-[17px] text-muted" set:html={section.intro} />}
              <Claims facts={section.facts} />
            </section>
          ))}
          {page.explain.facts.length > 0 && <Claims facts={page.explain.facts} />}
        </div>

        {page.items && (
          <section aria-labelledby="body" class="flex flex-col gap-4">
            <div class="flex flex-col gap-2.5">
              <span class="font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
                {page.items.eyebrow}
              </span>
              <h2 id="body" class="h-card text-[40px] leading-[1.05] tracking-[-0.03em] text-balance phone:text-[30px]">
                {page.items.title}
              </h2>
              <p class="m-0 max-w-[70ch] text-[16px] text-muted">{page.items.lead}</p>
            </div>
            <ul class="m-0 flex list-none flex-col p-0">
              {page.items.list.map((item) => (
                <li
                  id={`bod-${item.id}`}
                  class="grid gap-x-6 gap-y-1.5 border-t border-line py-4 first:border-t-0 md:grid-cols-[minmax(0,1fr)_220px]"
                >
                  <div class="flex min-w-0 flex-col gap-1">
                    <h3 class="m-0 flex flex-wrap items-center gap-2 text-[17px] leading-snug font-bold">
                      {item.title}
                      <Tag label={item.defaultOn} />
                    </h3>
                    <p class="m-0 text-[16px] text-muted [&_strong]:text-ink" set:html={item.why.html} />
                  </div>
                  <div class="flex flex-col items-start gap-1.5 md:pt-[3px]">
                    <BasisBadge basis={item.why.basis} label={item.why.basisLabel} mark={item.why.mark} />
                    <CiteLinks cites={item.why.cites} prefix={item.why.citesPrefix} />
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p
          class="m-0 max-w-[70ch] text-[14px] leading-normal text-muted [&_a]:text-ink [&_a]:underline"
          set:html={page.disclaimer}
        />
      </div>

      <aside aria-label={page.related.label} class="flex flex-col gap-3.5">
        {page.related.guides.cards.length > 0 && (
          <>
            <span class="font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
              {page.related.guides.title}
            </span>
            {page.related.guides.cards.map((card) => (
              <a
                href={card.href}
                class="card flex flex-col gap-1 rounded-[22px] px-[18px] py-4 text-ink no-underline transition-colors hover:border-ink"
              >
                <b class="text-[16.5px]">{card.title}</b>
                <span class="text-[14.5px] text-muted">{card.meta}</span>
              </a>
            ))}
          </>
        )}
        {page.related.documents.cards.length > 0 && (
          <>
            <span class="mt-2.5 font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
              {page.related.documents.title}
            </span>
            {page.related.documents.cards.map((card) => (
              <a
                href={card.href}
                class="card flex flex-col gap-1 rounded-[22px] px-[18px] py-4 text-ink no-underline transition-colors hover:border-ink"
              >
                <b class="text-[16.5px]">{card.title}</b>
                <span class="text-[14.5px] text-muted">{card.meta}</span>
              </a>
            ))}
          </>
        )}
        <h2 id="zdroje" class="mt-2.5 font-mono text-[12.5px] font-semibold tracking-[0.06em] text-muted uppercase">
          {page.related.sourcesTitle}
        </h2>
        {page.sources.map((group) => (
          <div class="flex flex-col gap-1.5">
            <h3 class="m-0 text-[14px] font-bold">{group.title}</h3>
            <ul class="m-0 flex list-none flex-col gap-1.5 p-0 text-[15px] leading-snug">
              {group.sources.map((source) => (
                <li>
                  <a
                    href={source.href}
                    rel="noopener"
                    class="text-ink underline decoration-line2 underline-offset-[3px] hover:decoration-current"
                  >
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </aside>
    </div>
  </section>
</Base>
