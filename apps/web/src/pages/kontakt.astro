---
import { Image } from 'astro:assets';

import { contactLimits, honeypotField } from '../../worker/contact.schema.ts';
import photo from '../assets/dejv.jpg';
import { contact } from '../content/contact.ts';
import Base from '../layouts/Base.astro';
import { toHtml } from '../lib/inline.ts';
import { turnstileSiteKey } from '../lib/site-env.ts';

const field = 'flex flex-col gap-1.5 text-sm font-semibold';
const input =
  'box-border h-12 w-full rounded-[14px] border border-line2 bg-card px-3.5 font-sans text-base font-normal text-ink';
---

<Base page="contact">
  <script slot="head" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <section class="bg-paper pt-[clamp(28px,3.6cqw,56px)] pb-[clamp(44px,4.4cqw,64px)] text-ink">
    <div class="wrap flex flex-wrap items-start gap-x-14 gap-y-8">
      <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-[22px]">
        <div class="flex flex-col gap-3.5">
          <span class="eyebrow">{contact.hero.eyebrow}</span>
          <h1 class="h-page max-w-[12ch]">{contact.hero.title}</h1>
          <p class="lead max-w-[56ch] text-muted">{contact.hero.lead}</p>
        </div>
        <p class="m-0 text-xl font-bold">
          <a href={`mailto:${contact.email}`} class="text-ink underline-offset-4">
            {contact.email}
          </a>
        </p>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-7 border-t border-line1 pt-8">
          <figure class="mt-1.5 mr-0 mb-2 ml-1.5 w-[220px] flex-none -rotate-[1.5deg] rounded-md border border-line bg-card px-2.5 pt-2.5 shadow-[0_10px_24px_-14px] shadow-ink-fixed/35">
            <Image
              src={photo}
              alt={contact.about.photoAlt}
              widths={[200, 400]}
              sizes="200px"
              class="block aspect-[4/5] h-auto w-full rounded-[3px] object-cover"
            />
            <figcaption class="px-1 pt-2 pb-2.5 text-center font-hand text-[22px] leading-[1.1] font-semibold text-muted">
              {contact.about.photoCaption}
            </figcaption>
          </figure>
          <div class="flex flex-[1_1_200px] flex-col gap-1">
            <strong>{contact.about.title}</strong>
            <span>{contact.about.name}</span>
            <span class="text-muted">{contact.about.text}</span>
            <span class="text-muted">{contact.about.ico}</span>
          </div>
        </div>
      </div>
      <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-[18px]">
        <form
          method="post"
          action="/api/kontakt"
          aria-label={contact.form.label}
          data-contact-form
          class="card flex flex-col gap-4 p-[clamp(20px,2.6cqw,32px)]"
        >
          <label class={field}>
            {contact.form.name}
            <input
              name="name"
              type="text"
              autocomplete="name"
              required
              maxlength={contactLimits.name.max}
              class={input}
            />
          </label>
          <label class={field}>
            {contact.form.organisation}
            <input
              name="organisation"
              type="text"
              autocomplete="organization"
              maxlength={contactLimits.organisation.max}
              class={input}
            />
          </label>
          <label class={field}>
            {contact.form.email}
            <input
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength={contactLimits.email.max}
              class={input}
            />
          </label>
          <label class={field}>
            {contact.form.message}
            <textarea
              name="message"
              rows="5"
              required
              minlength={contactLimits.message.min}
              maxlength={contactLimits.message.max}
              class:list={[input, 'h-[132px] resize-y py-3']}
            ></textarea>
          </label>
          <div aria-hidden="true" class="absolute -left-[9999px] size-px overflow-hidden">
            <label>
              {contact.form.trap}
              <input name={honeypotField} type="text" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="auto"
            data-language="cs"
            data-size="flexible"
            data-appearance="interaction-only"
          ></div>
          <noscript>
            <p class="m-0 text-[15px] text-muted">{contact.form.noscript}</p>
          </noscript>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <button type="submit" class="btn cursor-pointer font-sans disabled:cursor-wait disabled:opacity-70">
              {contact.form.submit}
            </button>
            <p data-status role="status" aria-live="polite" class="m-0 text-[15px] font-semibold"></p>
          </div>
          <p class="m-0 text-sm text-muted" set:html={toHtml(contact.form.privacy)} />
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/contact-form.ts';
</script>
