---
// The small pictures beside the first three steps of the year. Demo values.
import Icon from '../Icon.astro';

interface Props {
  kind: 'open' | 'payment' | 'consent';
  label: string;
}

const { kind, label } = Astro.props;
---

<div
  role="img"
  aria-label={label}
  class="hidden h-[164px] w-[148px] flex-none flex-col items-center justify-center gap-2 rounded-[22px] bg-chip p-3.5 text-ink lg:flex"
>
  {kind === 'open' && (
    <>
      <span class="flex items-center gap-2 self-stretch text-sm font-bold">
        <span class="flex h-6 w-10 flex-none justify-end rounded-full bg-camp p-[3px]">
          <span class="size-[18px] rounded-full bg-ink-fixed" />
        </span>
        Otevřeno
      </span>
      {['1. turnus', '2. turnus', '3. turnus'].map((turnus) => (
        <span class="flex h-[30px] items-center gap-2 self-stretch rounded-[10px] border border-line bg-card px-2.5 text-[13px] font-bold">
          <span class="size-2 rounded-full bg-camp" />
          {turnus}
        </span>
      ))}
    </>
  )}
  {kind === 'payment' && (
    <>
      <span class="flex size-16 items-center justify-center rounded-[14px] border border-line bg-card">
        <Icon name="qr" size={44} stroke={1.8} />
      </span>
      <span class="h-card text-[22px] leading-none tracking-[-0.03em]">6 900 Kč</span>
      <span class="inline-flex h-[26px] items-center gap-1 rounded-full bg-ok px-2.5 text-xs font-bold text-ok-fg">
        <Icon name="check" size={12} stroke={3.5} />
        Zaplaceno
      </span>
    </>
  )}
  {kind === 'consent' && (
    <>
      <span class="relative flex h-[72px] w-[60px] flex-col gap-1.5 rounded-[10px] border border-line bg-card px-2.5 py-3">
        <span class="h-[5px] rounded bg-line" />
        <span class="h-[5px] w-3/4 rounded bg-line" />
        <span class="h-[5px] rounded bg-line" />
        <span class="absolute -right-3 -bottom-2.5 flex size-8 items-center justify-center rounded-full bg-camp text-ink-fixed">
          <Icon name="check" size={18} stroke={3.5} />
        </span>
      </span>
      <span class="text-[15px] font-bold">Podepsáno</span>
    </>
  )}
</div>
