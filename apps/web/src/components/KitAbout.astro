---
// "Kdo za Průvodcem stojí": the block above the footer of every kit page, rendered by Base.astro in
// place of the closing band the product pages have.
import { kitAbout } from '../content/site.ts';
import Icon from './Icon.astro';
---

<aside aria-label={kitAbout.label} class="bg-paper pt-[clamp(16px,2cqw,24px)] pb-[clamp(36px,4cqw,56px)] text-ink">
  <div class="wrap">
    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 gap-y-3 rounded-[18px] border border-line bg-card px-[clamp(16px,2cqw,24px)] py-4 sm:grid-cols-[auto_minmax(0,1fr)_auto]">
      <span class="flex size-10 flex-none items-center justify-center rounded-full bg-fire text-ink-fixed">
        <Icon name="tent" stroke={2.5} />
      </span>
      <p class="m-0 text-[15px] leading-snug text-muted">
        <b class="block text-[17px] text-ink">{kitAbout.title}</b>
        {kitAbout.text}
      </p>
      <a
        href={kitAbout.action.href}
        class="btn btn-ghost col-span-2 h-11 justify-self-start px-4 text-[15px] sm:col-span-1"
      >
        {kitAbout.action.label}
      </a>
    </div>
  </div>
</aside>
