---
// What kind of statement a Fact is, as the design's claim row marks it: a small square with § for a
// regulation (quiet, the common case), Ú with a dashed border for an authority's reading, a dotted round
// O for an organisation's recommendation and a filled round c for ours. The four are told apart by the
// mark's border and shape, not by colour alone, and the label always says it.
import { kitLabels } from '../../content/kit/hub.ts';
import type { Basis } from '../../content/kit/types.ts';

interface Props {
  basis: Basis;
  label: string;
  // The mark; defaults to the basis's mark of kitLabels.
  mark?: string;
}

const { basis, label, mark = kitLabels.basisMark[basis] } = Astro.props;
---

<span
  data-basis={basis}
  class="group/kind inline-flex flex-none items-center gap-[7px] font-mono text-[11.5px] leading-[1.2] font-semibold tracking-[0.05em] text-ink uppercase data-[basis=law]:text-muted"
>
  <i
    aria-hidden="true"
    class="flex size-[18px] flex-none items-center justify-center rounded-[5px] border-[1.5px] border-ink text-[12px] font-bold tracking-normal not-italic group-data-[basis=advice]/kind:rounded-full group-data-[basis=advice]/kind:border-fire-soft group-data-[basis=advice]/kind:bg-fire-soft group-data-[basis=advice]/kind:text-night group-data-[basis=authority]/kind:border-dashed group-data-[basis=law]/kind:border-line2 group-data-[basis=practice]/kind:rounded-full group-data-[basis=practice]/kind:border-dotted"
  >
    {mark}
  </i>
  {label}
</span>
