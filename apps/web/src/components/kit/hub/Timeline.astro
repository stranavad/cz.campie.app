---
// Step 2 "Kdy co zařídit": the steps before, during and after the camp, each with its Facts as compact
// cards and its guides and templates. All of it is in the HTML. The date field is shown and run by
// src/scripts/deadlines.ts, which writes each dated step's day and distance (`data-offset`) and the
// summary line (`data-summary`); without JavaScript the field stays hidden.
import type { HubPage } from '../../../lib/kit/pages.ts';
import ClaimCard from './ClaimCard.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  timeline: HubPage['timeline'];
}

const { timeline } = Astro.props;
---

<section
  id="kdy"
  aria-labelledby="kdy-nadpis"
  data-deadlines
  data-labels={timeline.calculator.labels}
  class="pb-[72px] @max-[900px]:pb-12"
>
  <div class="wrap">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 @max-[900px]:mb-5">
      <SectionHead id="kdy" eyebrow={timeline.eyebrow} title={timeline.title} lead={timeline.lead} />
      <div
        data-deadline-form
        hidden
        class="flex flex-wrap items-end gap-x-4 gap-y-3 rounded-[18px] border border-line bg-card px-[18px] py-4 @max-[900px]:w-full"
      >
        <label class="flex flex-col gap-[5px] text-[13.5px] font-bold @max-[900px]:w-full">
          {timeline.calculator.label}
          <input
            type="date"
            data-deadline-input
            class="h-[46px] rounded-xl border-[1.5px] border-line2 bg-card px-3 text-[16px] font-normal text-ink [color-scheme:light] dark:[color-scheme:dark] @max-[900px]:w-full"
          />
        </label>
        <p data-deadline-summary aria-live="polite" class="m-0 max-w-[26ch] text-[14.5px] leading-[1.35] text-muted">
          {timeline.calculator.empty}
        </p>
      </div>
    </div>

    <ol class="m-0 flex list-none flex-col p-0">
      {timeline.steps.map((step) => (
        <li
          data-step
          data-offset={step.offset ?? undefined}
          data-summary={step.summary ?? undefined}
          data-marked={step.marked ? '' : undefined}
          class="group/step grid grid-cols-[200px_28px_minmax(0,1fr)] gap-x-[18px] @max-[900px]:grid-cols-[20px_minmax(0,1fr)] @max-[900px]:gap-x-3.5"
        >
          <div class="pt-0.5 pb-7 text-right @max-[900px]:col-start-2 @max-[900px]:row-start-1 @max-[900px]:pb-2.5 @max-[900px]:text-left">
            <p class="m-0 font-mono text-[12.5px] font-semibold tracking-[0.05em] uppercase">{step.when}</p>
            <h3 class="h-card mt-1 text-[22px] leading-[1.15] tracking-[-0.02em]">{step.title}</h3>
            <p data-step-date hidden class="m-0 mt-1 text-[13.5px] text-muted">
              <b data-date class="font-semibold text-ink"></b>
              <span data-distance></span>
            </p>
          </div>
          <div
            aria-hidden="true"
            class="relative flex justify-center before:absolute before:top-1.5 before:bottom-0 before:w-0.5 before:bg-line2 group-last/step:before:hidden @max-[900px]:col-start-1 @max-[900px]:row-span-2 @max-[900px]:row-start-1"
          >
            <i class="relative mt-[3px] block size-4 rounded-full border-[3px] border-ink bg-paper group-data-marked/step:border-fire-soft group-data-marked/step:bg-fire-soft"></i>
          </div>
          <div class="flex min-w-0 flex-col gap-2 pb-7 @max-[900px]:col-start-2 @max-[900px]:pb-6">
            {step.facts.map((fact) => (
              <ClaimCard fact={fact} />
            ))}
            {step.links.length > 0 && (
              <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-0.5 p-0 pt-0.5">
                {step.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="inline-flex min-h-8 items-center text-[14px] font-semibold text-ink underline underline-offset-[3px]"
                    >
                      {link.label} →
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="m-0 mt-1 ml-[246px] flex items-center gap-3 rounded-[14px] border-[1.5px] border-dashed border-line2 px-4 py-3 text-[15px] @max-[900px]:ml-0 @max-[900px]:flex-col @max-[900px]:items-start">
      <span>{timeline.bridge.text}</span>
      <a href={timeline.bridge.link.href} class="font-bold whitespace-nowrap text-ink underline-offset-[3px]">
        {timeline.bridge.link.label}
      </a>
    </p>
  </div>
</section>
