---
// The hub's top, right under the breadcrumbs: the year's news as a chip linking the changes, the h1, the
// lead, the verification line and three entry cards into the page (one column on phones).
import type { HubPage } from '../../../lib/kit/pages.ts';
import Verification from '../Verification.astro';

interface Props {
  page: Pick<HubPage, 'news' | 'hero' | 'verification' | 'entries'>;
}

const { news, hero, verification, entries } = Astro.props.page;
---

<section class="pt-2 pb-14 @max-[900px]:pb-5">
  <div class="wrap">
    <a
      href={news.href}
      class="inline-flex min-h-10 items-center gap-2.5 rounded-full border border-line2 bg-card py-1 pr-3.5 pl-1 text-[14.5px] font-semibold text-ink no-underline hover:border-ink @max-[900px]:flex @max-[900px]:flex-col @max-[900px]:items-start @max-[900px]:gap-1.5 @max-[900px]:rounded-2xl @max-[900px]:pt-2 @max-[900px]:pb-3 @max-[900px]:pl-2 @max-[900px]:leading-[1.35]"
    >
      <b class="inline-flex h-[30px] items-center rounded-full bg-fire px-2.5 font-mono text-[12px] leading-none font-semibold tracking-[0.03em] whitespace-nowrap text-ink-fixed">
        {news.tag}
      </b>
      <span>{news.text}</span>
      <span aria-hidden="true" class="@max-[900px]:hidden">
        →
      </span>
    </a>
    <h1 class="h-card mt-[18px] mb-3 max-w-[17ch] text-[60px] leading-[1.05] tracking-[-0.03em] text-balance @max-[900px]:text-[34px]">
      {hero.title}
    </h1>
    <p class="m-0 max-w-[58ch] text-[19px] text-muted @max-[900px]:text-[17px]">{hero.lead}</p>
    <Verification verification={verification} season={false} class="mt-3.5" />
    <ul class="m-0 mt-8 grid max-w-[960px] list-none grid-cols-3 gap-3 p-0 @max-[900px]:mt-6 @max-[900px]:grid-cols-1">
      {entries.map((entry) => (
        <li>
          <a
            href={entry.href}
            class="grid h-full grid-cols-[auto_minmax(0,1fr)] grid-rows-[auto_auto] items-center gap-x-3.5 gap-y-0.5 rounded-[18px] border border-line bg-card px-[18px] py-4 text-ink no-underline transition-[border-color,translate] duration-200 hover:-translate-y-0.5 hover:border-ink motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            <span
              aria-hidden="true"
              class="row-span-2 flex size-11 items-center justify-center rounded-[13px] bg-forest text-cream"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={entry.icon}></path>
              </svg>
            </span>
            <b class="text-[17px] leading-[1.2]">{entry.title}</b>
            <span class="text-[14px] leading-[1.3] text-muted">{entry.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
