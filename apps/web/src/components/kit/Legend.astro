---
// How to read a page of the kit: one compact line of the four marks, opening to what each means and what
// "I menší akce" says.
import { kitLabels } from '../../content/kit/hub.ts';
import { basisLegend } from '../../lib/kit/facts.ts';
import Icon from '../Icon.astro';
import BasisBadge from './BasisBadge.astro';
import Tag from './Tag.astro';
---

<aside aria-label={kitLabels.legendTitle}>
  <details class="group rounded-[14px] bg-chip text-[14px] text-ink">
    <summary class="flex min-h-11 cursor-pointer flex-wrap items-center gap-x-5 gap-y-2.5 px-4 py-3">
      {basisLegend.map((item) => (
        <BasisBadge basis={item.basis} label={item.label} mark={item.mark} />
      ))}
      <span class="inline-flex items-center gap-1.5 font-semibold text-muted group-hover:text-ink sm:ml-auto">
        {kitLabels.legendMore}
        <Icon name="chevron" size={14} class="transition-transform group-open:rotate-180" />
      </span>
    </summary>
    <dl class="m-0 grid gap-x-8 gap-y-3.5 border-t border-line2 px-4 pt-3.5 pb-4 sm:grid-cols-2">
      {basisLegend.map((item) => (
        <div class="flex flex-col items-start gap-1.5">
          <dt>
            <BasisBadge basis={item.basis} label={item.label} mark={item.mark} />
          </dt>
          <dd class="m-0 text-[14.5px] leading-normal text-muted">{item.text}</dd>
        </div>
      ))}
      <div class="flex flex-col items-start gap-1.5 sm:col-span-2">
        <dt>
          <Tag label={kitLabels.smallToo} />
        </dt>
        <dd class="m-0 text-[14.5px] leading-normal text-muted">{kitLabels.smallTooLegend}</dd>
      </div>
    </dl>
  </details>
</aside>
