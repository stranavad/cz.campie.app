---
// A drawn sheet of paper for a template's card: a title bar, lines of text and a signature line. The
// sheet is paper in both themes, like the document it stands for.
interface Props {
  size?: 'sm' | 'lg';
}

const { size = 'sm' } = Astro.props;
---

<span
  aria-hidden="true"
  data-size={size}
  class="flex h-24 flex-col gap-1.5 rounded-lg border border-line bg-sheet px-3.5 py-3 data-[size=lg]:h-40 data-[size=lg]:gap-2 data-[size=lg]:px-5 data-[size=lg]:py-4"
>
  <i class="block h-[7px] w-[55%] rounded-[3px] bg-sheet-ink/70"></i>
  <i class="block h-[5px] w-full rounded-[3px] bg-sheet-rule/35"></i>
  <i class="block h-[5px] w-[85%] rounded-[3px] bg-sheet-rule/35"></i>
  <i class="block h-[5px] w-[92%] rounded-[3px] bg-sheet-rule/35"></i>
  <i class="block h-[5px] w-[60%] rounded-[3px] bg-sheet-rule/35"></i>
  <i class="mt-auto ml-auto block h-px w-[38%] bg-sheet-rule"></i>
</span>
