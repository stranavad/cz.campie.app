---
// The admin interface's sidebar, as drawn in the screens on the home page. Demo values.
import { icons } from '../../content/icons.ts';

interface Props {
  active: 'overview' | 'registrations';
}

const { active } = Astro.props;
const items = [
  { key: 'overview', label: 'Přehled', d: 'm3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM9 22V12h6v10' },
  {
    key: 'registrations',
    label: 'Přihlášky',
    d: 'M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zM16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2M12 11h4M12 16h4M8 11h.01M8 16h.01',
    badge: '16',
  },
  { key: 'camps', label: 'Tábory', d: icons.camp },
  {
    key: 'team',
    label: 'Tým',
    d: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
  {
    key: 'organisation',
    label: 'Organizace',
    d: 'M6 2h12a2 2 0 0 1 2 2v18H4V4a2 2 0 0 1 2-2zM9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01',
  },
  { key: 'history', label: 'Historie', d: 'M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5M12 7v5l4 2' },
];
---

<div class="flex w-[248px] flex-none flex-col gap-5 border-r border-app-border bg-app-side px-4 py-5">
  <div class="flex items-center gap-3 px-1.5 py-1">
    <span class="flex size-[42px] flex-none items-center justify-center rounded-full bg-app-accent text-stone">
      <svg
        width="21"
        height="21"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={icons.camp}></path>
      </svg>
    </span>
    <span class="flex flex-1 flex-col leading-[1.2]">
      <span class="font-display text-[17px] font-bold tracking-[-0.01em]">Tábor Jezero</span>
      <span class="text-xs text-app-muted">z. s. · Vlastník</span>
    </span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m7 15 5 5 5-5M7 9l5-5 5 5"></path>
    </svg>
  </div>
  <div class="flex flex-col gap-0.5">
    {items.map((item) => (
      <span
        class:list={[
          'flex h-11 items-center gap-3 rounded-full px-3.5',
          item.key === active ? 'bg-app-soft font-bold text-app-text' : 'font-medium text-app-nav',
        ]}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class:list={[item.key === active && 'text-app-soft-icon']}
        >
          <path d={item.d} />
        </svg>
        <span class:list={[item.key === active && 'text-app-text']}>{item.label}</span>
        {item.badge && (
          <span class="ml-auto flex h-[22px] min-w-[22px] items-center justify-center rounded-full bg-app-chip px-[7px] text-xs font-bold text-app-text">
            {item.badge}
          </span>
        )}
      </span>
    ))}
  </div>
</div>
