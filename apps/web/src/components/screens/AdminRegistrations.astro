---
// The admin list of Registrations with their payments (the platform's "Přihlášky"), the top 1280 x 900 px
// of it. Demo values; the parents' addresses are on example.com.
import { icons } from '../../content/icons.ts';
import AdminSidebar from './AdminSidebar.astro';

const tones = {
  ok: 'bg-app-ok text-app-ok-fg',
  warn: 'bg-app-warn text-app-warn-fg',
  bad: 'bg-app-bad text-app-bad-fg',
  neutral: 'bg-app-neutral text-app-neutral-fg',
};
const payments = {
  paid: { label: 'Zaplaceno', tone: tones.ok },
  part: { label: 'Částečně', tone: tones.warn },
  unpaid: { label: 'Nezaplaceno', tone: tones.neutral },
  overdue: { label: 'Po splatnosti', tone: tones.bad },
};
const documents = {
  ok: { label: 'Vše odevzdáno', tone: tones.neutral },
  review: { label: 'Ke kontrole', tone: tones.warn },
  missing: { label: 'Chybí', tone: tones.bad },
};
const rows = [
  [
    'AN',
    'Anna Nováková',
    '11 let',
    'Jana Nováková',
    'jana.novakova',
    payments.part,
    '2 / 2',
    documents.missing,
    'dnes',
  ],
  ['TN', 'Tomáš Novák', '9 let', 'Jana Nováková', 'jana.novakova', payments.part, '2 / 2', documents.review, 'dnes'],
  ['ED', 'Eliška Dvořáková', '10 let', 'Petra Dvořáková', 'petra.d', payments.paid, '2 / 2', documents.ok, '7. 2.'],
  [
    'MS',
    'Matěj Svoboda',
    '12 let',
    'Martin Svoboda',
    'msvoboda',
    payments.overdue,
    '0 / 2',
    documents.missing,
    '6. 2.',
  ],
  [
    'KP',
    'Klára Procházková',
    '8 let',
    'Lucie Procházková',
    'lucie.p',
    payments.paid,
    '2 / 2',
    documents.review,
    '5. 2.',
  ],
  ['VČ', 'Vojtěch Černý', '11 let', 'Ondřej Černý', 'cerny.o', payments.unpaid, '1 / 2', documents.missing, '4. 2.'],
  ['AV', 'Adéla Veselá', '10 let', 'Kateřina Veselá', 'k.vesela', payments.paid, '2 / 2', documents.ok, '2. 2.'],
  ['JH', 'Jakub Horák', '12 let', 'Tomáš Horák', 'horak.t', payments.paid, '2 / 2', documents.ok, '1. 2.'],
  ['EH', 'Ema Horáková', '8 let', 'Tomáš Horák', 'horak.t', payments.paid, '2 / 2', documents.ok, '1. 2.'],
  ['FK', 'Filip Kučera', '10 let', 'Monika Kučerová', 'kucerova.m', payments.part, '2 / 2', documents.review, '31. 1.'],
  ['NP', 'Natálie Pokorná', '9 let', 'Jiří Pokorný', 'pokorny.j', payments.paid, '1 / 2', documents.ok, '30. 1.'],
] as const;
const tabs = [
  { label: 'Všechny', count: '38', selected: true },
  { label: 'Zaplaceno', count: '24' },
  { label: 'Částečně', count: '8' },
  { label: 'Nezaplaceno', count: '3' },
];
const outline =
  'flex h-11 items-center gap-2 rounded-full border border-app-btn-border bg-app-surface px-4 font-semibold';
---

<div class="flex h-[900px] w-[1280px] bg-app-bg font-sans text-[15px] leading-normal text-app-text">
  <AdminSidebar active="registrations" />
  <div class="flex min-w-0 flex-1 flex-col gap-5 px-10 pt-8 pb-12">
    <div class="flex items-center gap-3">
      <span class="flex-1 font-display text-[36px] leading-[1.1] font-extrabold tracking-[-0.03em]">Přihlášky</span>
      <span class={outline}>
        <span class="size-2 rounded-full bg-app-accent"></span>1. turnus · 5.-18. 7.
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d={icons.chevron}></path>
        </svg>
      </span>
      <span class={outline}>Připomenout</span>
      <span class={outline}>Export</span>
      <span class="flex h-11 items-center gap-2 rounded-full bg-app-primary px-[18px] font-bold text-app-primary-fg">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d={icons.plus}></path>
        </svg>
        Nová přihláška
      </span>
    </div>

    <div class="flex items-center gap-2">
      <div class="flex gap-1 rounded-full bg-app-chip p-1">
        {tabs.map((tab) => (
          <span
            class:list={[
              'flex h-9 items-center gap-1 rounded-full px-3.5 text-sm',
              tab.selected ? 'bg-app-surface font-semibold text-app-text' : 'font-medium text-app-nav',
            ]}
          >
            {tab.label} <span class="text-app-subtle">{tab.count}</span>
          </span>
        ))}
        <span class="flex h-9 items-center rounded-full px-3.5 text-sm font-semibold text-app-bad-fg">
          Po splatnosti 3
        </span>
      </div>
      <span class="flex-1"></span>
      <span class="flex h-11 w-[300px] items-center gap-2.5 rounded-full border border-app-btn-border bg-app-surface px-3.5 text-app-subtle">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        Hledat jméno, e-mail…
      </span>
    </div>

    <div class="overflow-hidden rounded-3xl border border-app-border bg-app-surface">
      <div class="grid grid-cols-[1.35fr_1.45fr_1fr_0.7fr_1fr_0.75fr] text-sm">
        {['Účastník', 'Rodič', 'Platba', 'Souhlasy', 'Dokumenty', 'Přihlášeno'].map((heading, index) => (
          <span class:list={['py-3.5 pr-3 text-[13px] text-app-muted', index === 0 ? 'pl-5' : 'pl-3']}>{heading}</span>
        ))}
        {rows.map(([initials, child, age, parent, mailbox, payment, consents, document, date]) => (
          <>
            <span class="flex items-center gap-3 border-t border-app-line py-3 pr-3 pl-5">
              <span class="flex size-9 flex-none items-center justify-center rounded-full bg-app-chip text-[13px] font-bold">
                {initials}
              </span>
              <span class="flex flex-col leading-[1.3]">
                <span class="text-[15px] font-semibold">{child}</span>
                <span class="text-[13px] text-app-muted">{age}</span>
              </span>
            </span>
            <span class="flex flex-col justify-center border-t border-app-line p-3 leading-[1.3]">
              <span>{parent}</span>
              <span class="text-[13px] text-app-muted">{mailbox}@example.com</span>
            </span>
            <span class="flex items-center border-t border-app-line p-3">
              <span
                class:list={[
                  'inline-flex h-7 items-center gap-1.5 rounded-full px-2.5 text-[13px] font-semibold whitespace-nowrap',
                  payment.tone,
                ]}
              >
                <span class="size-[7px] rounded-full bg-current" />
                {payment.label}
              </span>
            </span>
            <span
              class:list={[
                'flex items-center border-t border-app-line p-3 font-medium',
                consents === '2 / 2' ? 'text-app-muted' : 'text-app-bad-fg',
              ]}
            >
              {consents}
            </span>
            <span class="flex items-center border-t border-app-line p-3">
              <span
                class:list={[
                  'inline-flex h-7 items-center rounded-full px-2.5 text-[13px] font-semibold whitespace-nowrap',
                  document.tone,
                ]}
              >
                {document.label}
              </span>
            </span>
            <span class="flex items-center border-t border-app-line py-3 pr-5 pl-3 text-app-muted">{date}</span>
          </>
        ))}
      </div>
    </div>
  </div>
</div>
