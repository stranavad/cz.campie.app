{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && wrangler deploy --dry-run --env= --outdir node_modules/.tmp/worker",
    "preview": "wrangler dev",
    "deploy:production": "SITE_ENV=production astro build && wrangler deploy --env=",
    "deploy:dev": "SITE_ENV=dev astro build && wrangler deploy --env dev",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint-staged": "lint-staged",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@repo/oxlint-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.159.0"
  }
}
