// The marketing site on Cloudflare Workers: the static build in dist/ served as assets, and the Worker in
// worker/ answering /api/* (the contact form). `pnpm deploy:production` deploys campie.cz,
// `pnpm deploy:dev` the preview on dev.campie.cz. Secrets: RESEND_API_KEY and TURNSTILE_SECRET_KEY, set
// per environment with `wrangler secret put`; locally from .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campie-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "campie.cz", "custom_domain": true }],
  "vars": {
    "CONTACT_TO": "info@campie.cz",
    "CONTACT_FROM": "Campie web <web@posta.campie.cz>",
  },
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "env": {
    "dev": {
      "name": "campie-web-dev",
      "routes": [{ "pattern": "dev.campie.cz", "custom_domain": true }],
      "vars": {
        "CONTACT_TO": "info@campie.cz",
        "CONTACT_FROM": "Campie web dev <web@posta.campie.cz>",
      },
      "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
    },
  },
}
