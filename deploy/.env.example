# The environment of a deployment of compose.yaml (next to this file) on Dokploy: production, and staging
# with its own values. Set each variable in Dokploy's environment for the compose service, which writes them
# to .env beside compose.yaml; secrets stay there and never reach the repository. A value given here is the
# same for both deployments unless its comment says otherwise.

# production or staging. Staging is a copy that takes no live payments, with its own Neon branch, Tigris
# bucket, master key and secrets: never production's.
APP_ENV=production
# Unique per deployment on the server: names its Traefik router. Staging: campie-staging.
DEPLOYMENT_NAME=campie-production
# The platform domain: app.<domain> is the main host, every other single label an Organisation's subdomain.
# Staging: staging.campie.cz (so app.staging.campie.cz and <subdomain>.staging.campie.cz).
PLATFORM_DOMAIN=campie.cz
PRODUCT_NAME=Campie
# A Traefik certificate resolver with a DNS challenge, configured in Dokploy's Traefik, for the wildcard
# certificate of *.<PLATFORM_DOMAIN>; an HTTP challenge cannot issue one.
TRAEFIK_CERT_RESOLVER=

# New signups and problem reports are announced here.
PLATFORM_OPERATOR_EMAIL=
# Shown to guardians as the contact for technical problems.
PLATFORM_SUPPORT_EMAIL=info@campie.cz

# The secret the frontend's proxy sends with every request to the API, which refuses any request without
# it. Secret, at least 32 characters: `openssl rand -hex 32`.
PROXY_SECRET=
# The secret Traefik adds to every request it routes to the frontend, whose proxy serves /api only with it:
# another project's container on Dokploy's shared network could otherwise call the proxy directly with a
# forged X-Forwarded-For. Secret, its own per deployment: `openssl rand -hex 32`.
EDGE_SECRET=

# Neon. The API connects as the application role campie_app, whose login and password are set once per
# branch as the owner: ALTER ROLE campie_app LOGIN PASSWORD '...'. Secret.
DATABASE_URL=
# The role that owns the tables (the database owner on Neon), used only by the migrate service and the
# operator command line. Use the direct connection string, not the pooled one. Secret.
MIGRATION_DATABASE_URL=

# Resend: the API key, and the signing secret (whsec_...) of the webhook for bounces and complaints at
# https://app.<PLATFORM_DOMAIN>/api/webhooks/mail. Secret.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# The two sending streams, each on its own subdomain of the platform's mail domain: login links, email
# verification and invitations, and everything else. Staging: its own subdomains.
MAIL_AUTH_FROM=prihlaseni@auth.campie.cz
MAIL_NOTIFICATION_FROM=info@posta.campie.cz

# Tigris. The secret access key is secret.
TIGRIS_STORAGE_ENDPOINT=https://t3.storage.dev
TIGRIS_STORAGE_BUCKET=
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=

# Production: comgate with COMGATE_TEST_PAYMENTS=false; it refuses to start with true. Staging takes no live
# payments and refuses to start with them: fake, or comgate with COMGATE_TEST_PAYMENTS=true against
# Organisations' Comgate test accounts.
PAYMENT_GATEWAY_ADAPTER=comgate
COMGATE_TEST_PAYMENTS=false

# Encrypts every Organisation's data key: 32 random bytes in base64, `openssl rand -base64 32`. Losing it
# loses every encrypted value, so keep a copy outside the server. Secret, and its own per deployment.
MASTER_KEY=

# Failed admin logins allowed per email and per IP address within the lockout period, which then blocks them.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15

# Anonymous requests that send mail or create data, allowed per IP address and per target within the window.
REQUEST_LIMIT_WINDOW_MINUTES=60
SIGNUP_LIMIT_PER_IP=10
SIGNUP_LIMIT_PER_EMAIL=5
PASSWORD_RESET_LIMIT_PER_IP=20
PASSWORD_RESET_LIMIT_PER_EMAIL=3
PRICE_PREVIEW_LIMIT_PER_IP=600
PRICE_PREVIEW_LIMIT_PER_ORGANISATION=20000
SUBMISSION_LIMIT_PER_IP=50
SUBMISSION_LIMIT_PER_ORGANISATION=5000
LOGIN_LINK_LIMIT_PER_IP=30
LOGIN_LINK_LIMIT_PER_EMAIL=5
GATEWAY_NOTIFICATION_LIMIT_PER_IP=20000
GATEWAY_NOTIFICATION_LIMIT_PER_ORGANISATION=2000
CARD_PAYMENT_LIMIT_PER_IP=100
CARD_PAYMENT_LIMIT_PER_ORGANISATION=5000
PAYMENT_REMINDER_LIMIT_PER_ORGANISATION=10
GUARDIAN_ACTION_LIMIT_PER_IP=300
GUARDIAN_ACTION_LIMIT_PER_EMAIL=100
PROBLEM_REPORT_LIMIT_PER_IP=20
PROBLEM_REPORT_LIMIT_PER_TARGET=50
