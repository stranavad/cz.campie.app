# The production images build from the source; the dev image needs only package.json. Never send
# dependencies, build output, env files (they may hold secrets) or other worktrees.
**/node_modules
**/dist
**/.turbo
**/coverage
**/.env
**/.env.*
.git
.github
.husky
.claude
.agents
docs
compose.yaml
deploy
Dockerfile
# The marketing website deploys to Cloudflare, not in an image; only its manifest, for the frozen install.
apps/web/*
!apps/web/package.json
